// config/toucan.keymap
// Selenium (https://github.com/OneDeadKey/selenium), via zmk-config-aekeynox.

// --- Optional settings: define BEFORE the #include, not by editing
// zmk-config-aekeynox/include/aekeynox/settings.h — that file lives inside
// the pulled dependency and any edits there are lost on the next `west update`.
// #define KB_LAYOUT_QWERTY_INTL   // uncomment if your OS isn't plain US QWERTY
#define MACOS                   // uncomment if this build targets a Mac
// #define VIM_NAVIGATION          // Vim-style nav/num split layer
// #define HRM_SHIFT               // adds a pinky-shift home row mod

// Toucan's active 34 keys: 5+5 main columns per row, no outer columns — but
// the *inner* thumb key on each hand survived (positions 37/38 & 39/40),
// not the outer one, so this uses LT2/LT3/RT3/RT2, unlike the Ferris/Re:Gret
// examples which keep LT1/LT2/RT2/RT1.
#define SELENIUM_KEYMAP_BINDINGS(LOUT1,  LROW1,  RROW1,  ROUT1, \
                                 LOUT2,  LROW2,  RROW2,  ROUT2, \
                                 LOUT3,  LROW3,  RROW3,  ROUT3, \
                                 LT1, LT2, LT3,  RT3, RT2, RT1) \
      LROW1   RROW1 \
      LROW2   RROW2 \
      LROW3   RROW3 \
    LT2 LT3   RT3 RT2

// Only two thumb keys per hand -> forces Selenium's 2TK hold-tap flavor.
#define FOUR_THUMB_KEYS

#include <aekeynox/selenium.keymap>
